default_platform(:android)

platform :android do
  def get_next_version_code
    begin
      codes = google_play_track_version_codes(
        package_name: "com.dirzaaulia.footballclips",
        json_key_data: ENV['PLAY_CONSOLE_JSON_KEY']
      )
      max_code = codes.compact.max || 26
      [max_code + 1, 27].max
    rescue => e
      UI.message("Could not fetch version code from Play Console: #{e.message}")
      27
    end
  end

  desc "Build and Upload Release AAB to Google Play Console Internal Track"
  lane :internal do
    next_code = get_next_version_code
    gradle(
      task: ":app:bundleRelease",
      properties: {
        "VERSION_CODE" => next_code.to_s
      }
    )
    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV['PLAY_CONSOLE_JSON_KEY'],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and Upload Release AAB to Google Play Console Alpha Track (Closed Testing)"
  lane :alpha do
    next_code = get_next_version_code
    gradle(
      task: ":app:bundleRelease",
      properties: {
        "VERSION_CODE" => next_code.to_s
      }
    )
    upload_to_play_store(
      track: "alpha",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV['PLAY_CONSOLE_JSON_KEY'],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and Upload Release AAB to Google Play Console Beta Track (Open Testing)"
  lane :beta do
    next_code = get_next_version_code
    gradle(
      task: ":app:bundleRelease",
      properties: {
        "VERSION_CODE" => next_code.to_s
      }
    )
    upload_to_play_store(
      track: "beta",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV['PLAY_CONSOLE_JSON_KEY'],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and Upload Release AAB to Google Play Console Production Track"
  lane :production do
    next_code = get_next_version_code
    gradle(
      task: ":app:bundleRelease",
      properties: {
        "VERSION_CODE" => next_code.to_s
      }
    )
    upload_to_play_store(
      track: "production",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV['PLAY_CONSOLE_JSON_KEY'],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
