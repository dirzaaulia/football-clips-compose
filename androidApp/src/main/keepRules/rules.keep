# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Keep WebView JavascriptInterface methods for YouTubePlayerBridge in R8 release builds
-keepattributes JavascriptInterface
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}
-keep class com.dirzaaulia.footballclips.ui.player.YouTubePlayerBridge {
    public *;
}

# Keep BuildConfig fields for runtime environment detection (Release Track, Version Name)
-keep class com.dirzaaulia.footballclips.BuildConfig { *; }