control.fc.dirzaaulia.com {
    root * /var/www/dashboard
    file_server
}

db.fc.dirzaaulia.com {
    reverse_proxy jarvis-nocodb:8080
}

files.fc.dirzaaulia.com {
    handle /countries/textures/* {
        root * /var/www/cloud
        file_server
    }
    handle {
        reverse_proxy jarvis-filebrowser:80
    }
}

api.fc.dirzaaulia.com, edge.fc.dirzaaulia.com {
    @rest path /rest/v1/*
    handle @rest {
        uri strip_prefix /rest/v1
        reverse_proxy jarvis-postgrest:3000 {
            header_up -Authorization
            header_up -apikey
        }
    }
    handle {
        reverse_proxy jarvis-postgrest:3000 {
            header_up -Authorization
            header_up -apikey
        }
    }
}
