{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FootballShort",
  "type": "object",
  "required": ["youtube_video_id", "title", "channel_id", "channel_name", "category", "duration_seconds", "hype_score", "published_at"],
  "properties": {
    "youtube_video_id": { "type": "string", "minLength": 11, "maxLength": 11 },
    "title": { "type": "string" },
    "channel_id": { "type": "string" },
    "channel_name": { "type": "string" },
    "club_id": { "type": ["integer", "null"] },
    "category": { "type": "string", "enum": ["GOALS_SKILLS", "MOMENTS"] },
    "thumbnail_url": { "type": "string", "format": "uri" },
    "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 180 },
    "hype_score": { "type": "integer", "minimum": 60, "maximum": 100 },
    "is_featured": { "type": "boolean" },
    "published_at": { "type": "string", "format": "date-time" }
  }
}
