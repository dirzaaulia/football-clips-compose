{
  "hosting": [
    {
      "site": "footballclips",
      "public": "web/out",
      "cleanUrls": true,
      "headers": [
        {
          "source": "/telemetry{,/**}",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/ads.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        },
        {
          "source": "/app-ads.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        },
        {
          "source": "/**/*.wasm",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/wasm"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/telemetry",
          "destination": "/telemetry/index.html"
        },
        {
          "source": "/telemetry/**",
          "destination": "/telemetry/index.html"
        },
        {
          "source": "/match/**",
          "destination": "/match.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "trailingSlash": false
    },
    {
      "site": "footballclips-telemetry",
      "public": "webApp/build/dist/wasmJs/productionExecutable",
      "cleanUrls": true,
      "headers": [
        {
          "source": "/**/*.wasm",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/wasm"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "trailingSlash": false
    }
  ]
}
