{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "postbuild": "node -e \"const fs=require('fs'),path=require('path'); const src = fs.existsSync('out/telemetry.html') ? 'out/telemetry.html' : (fs.existsSync('web/out/telemetry.html') ? 'web/out/telemetry.html' : null); if(src){ const destDir = path.join(path.dirname(src), 'telemetry'); fs.mkdirSync(destDir, {recursive:true}); fs.copyFileSync(src, path.join(destDir, 'index.html')); }\"",
    "deploy": "next build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@revenuecat/purchases-js": "^1.70.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-table": "^9.3.1",
    "@types/pg": "^8.23.1",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "firebase": "^13.0.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "postcss": "^8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
